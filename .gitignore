# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/gouroboros

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Temporary dir for testing
/tmp/
/internal/test/peersharing-interop/configs
/internal/test/peersharing-interop/overlays

# IDEs
.idea/
.vscode/

# Git worktrees
.worktrees/

# Example build output. `make build` writes each example to the repository
# root; `go build` inside an example writes examples/<name>/<name>.
/block-fetch
/chain-sync
/chain-tip
/peer-sharing
/ping
/state-query
/tx-monitor
/tx-submission
/examples/*/*
!/examples/*/*.*
!/examples/*/*/
